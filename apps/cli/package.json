{
  "name": "@danielbaars/anthracite",
  "version": "0.2.0",
  "license": "AGPL-3.0-only",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "homepage": "https://github.com/danielbaars/anthracite",
  "repository": "github:danielbaars/anthracite",
  "dependencies": {
    "@danerwilliams/gti-cli-shared-types": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@withgraphite/graphite-cli-routes": "^0.31.0",
    "@withgraphite/retype": "^0.3.11",
    "@withgraphite/retyped-routes": "^0.3.1",
    "chalk": "^4.1.2",
    "fast-json-stable-hash": "^1.0.3",
    "fs-extra": "^10.1.0",
    "prompts": "^2.4.2",
    "semver": "^7.3.7",
    "strip-ansi": "^6.0.1",
    "tmp": "^0.2.1",
    "yargs": "^17.5.1",
    "zod": "4.6.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "yarn build",
    "postinstall": "node scripts/node_version.js || node dist/scripts/node_version.js",
    "lint": "eslint src --quiet --ext .ts --cache",
    "check": "tsc --noEmit",
    "build": "rm -rf dist/ && yarn lint && tsc && cp scripts/node_version.js dist/scripts/node_version.js",
    "build-binary": "bun build --compile ./dist/src/index.js",
    "dev": "./scripts/installation/develop.sh",
    "cli": "node ./dist/src/index.js",
    "test": "tsc && node ../../scripts/test-cli.cjs node",
    "test-ci": "tsc && node ../../scripts/test-cli.cjs node",
    "test-one": "tsc && yarn mocha",
    "test-grep": "tsc && yarn mocha \"dist/test/**/*.test.js\" -g",
    "test-native": "node ../../scripts/test-cli.cjs native",
    "test-large-repos": "tsc && mocha dist/test/large_repo.test.js"
  },
  "nyc": {
    "exclude": ".yarn/**/*"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "an": "dist/src/index.js",
    "anthracite": "dist/src/index.js"
  },
  "devDependencies": {
    "@types/chai": "^4.3.1",
    "@types/chai-as-promised": "^7.1.5",
    "@types/fs-extra": "^9.0.13",
    "@types/mocha": "^9.1.1",
    "@types/node": "22.10.2",
    "@types/prettier": "^2",
    "@types/prompts": "^2.4.3",
    "@types/semver": "^7",
    "@types/tmp": "^0.2.3",
    "@types/yargs": "^17.0.10",
    "@typescript-eslint/eslint-plugin": "^5.27.1",
    "@typescript-eslint/parser": "^5.27.1",
    "chai": "^4.3.6",
    "chai-as-promised": "^7.1.1",
    "eslint": "^8.17.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.2.1",
    "mocha": "^10.0.0",
    "nock": "^13.2.6",
    "nyc": "^15.1.0",
    "pinst": "^3.0.0",
    "prettier": "^2.8.3",
    "ts-node": "^10.8.1",
    "typescript": "5.5.4"
  },
  "private": true,
  "bugs": {
    "url": "https://github.com/danielbaars/anthracite/issues"
  }
}
